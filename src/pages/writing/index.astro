
---
import MainLayout from "../../layouts/MainLayout.astro";
import { getCollection } from "astro:content";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const posts = (await getCollection("posts"))
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) =>
      b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );
---

<MainLayout
  title="Writing — Muhamad Ihsan"
  description="Kumpulan tulisan dan gagasan Muhamad Ihsan."
>
  <section class="page-intro">
    <p class="eyebrow">PERSONAL JOURNAL</p>
    <h1>Writing</h1>
    <p>
      Gagasan, esai, refleksi, dan catatan perjalanan
      intelektual.
    </p>
  </section>

  <section class="post-list">
    {posts.map((post) => (
      <article class="post-item">
        <p class="post-meta">
          {post.data.category} ·
          {" "}
          {post.data.pubDate.toLocaleDateString("id-ID", {
            day: "numeric",
            month: "long",
            year: "numeric",
          })}
        </p>

        <h2>
          <a href={`${base}writing/${post.id}/`}>
            {post.data.title}
          </a>
        </h2>

        <p>{post.data.description}</p>

        <a class="read-more" href={`${base}writing/${post.id}/`}>
          Baca tulisan →
        </a>
      </article>
    ))}
  </section>
</MainLayout>
