
---
import MainLayout from "../layouts/MainLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<MainLayout
  title="Muhamad Ihsan, S.Ud., Gr. — Personal Space"
  description="Ruang pemikiran, pengetahuan, pendidikan, dan teknologi."
>

  <section class="hero">
    <p class="eyebrow">PERSONAL KNOWLEDGE SPACE</p>

    <h1>
      Thinking, Learning,<br />
      Teaching & Building.
    </h1>

    <p class="hero-description">
      Ruang pribadi untuk mencatat pemikiran,
      mengembangkan pengetahuan, berbagi pengalaman,
      dan membangun sesuatu yang bermanfaat.
    </p>

    <a class="primary-link" href="#about">
      Mengenal lebih jauh →
    </a>
  </section>

  <section class="intro-section" id="about">
    <p class="eyebrow">ABOUT THIS SPACE</p>

    <h2>Selamat datang di ruang saya.</h2>

    <p>
      Saya Muhamad Ihsan, S.Ud., Gr.
      Ruang ini merupakan dokumentasi perjalanan
      intelektual, pendidikan, dan eksplorasi teknologi.
    </p>
  </section>

  <section class="content-section">
    <p class="eyebrow">EXPLORE</p>
    <h2>Ruang pengetahuan</h2>

    <div class="category-grid">

      <a class="category-card" href={`${base}writing/`}>
        <span>01 / WRITING</span>
        <h3>Writing</h3>
        <p>
          Gagasan, esai, refleksi, dan pemikiran.
        </p>
      </a>

      <a class="category-card" href={`${base}knowledge/`}>
        <span>02 / KNOWLEDGE</span>
        <h3>Knowledge</h3>
        <p>
          Catatan ilmu, literatur, dan pembelajaran.
        </p>
      </a>

      <a class="category-card" href={`${base}education/`}>
        <span>03 / EDUCATION</span>
        <h3>Education</h3>
        <p>
          Pendidikan, pengajaran, dan pengalaman madrasah.
        </p>
      </a>

      <a class="category-card" href={`${base}technology/`}>
        <span>04 / TECHNOLOGY</span>
        <h3>Technology</h3>
        <p>
          JavaScript, software engineering, dan AI.
        </p>
      </a>

      <a class="category-card" href={`${base}projects/`}>
        <span>05 / PROJECTS</span>
        <h3>Projects</h3>
        <p>
          Aplikasi, eksperimen, dan karya digital.
        </p>
      </a>

    </div>
  </section>

</MainLayout>
