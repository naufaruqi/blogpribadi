
---
const base = import.meta.env.BASE_URL;
const baseWithSlash = base.endsWith("/") ? base : `${base}/`;

const menus = [
  { label: "Home", href: base },
  { label: "Writing", href: `${baseWithSlash}writing/` },
  { label: "Knowledge", href: `${baseWithSlash}knowledge/` },
  { label: "Education", href: `${baseWithSlash}education/` },
  { label: "Technology", href: `${baseWithSlash}technology/` },
  { label: "Projects", href: `${baseWithSlash}projects/` },
  { label: "About", href: `${base}#about` },
];
---

<header class="site-header">
  <a class="brand" href={base}>
    Muhamad Ihsan<span>.</span>
  </a>

  <nav aria-label="Navigasi utama">
    {menus.map((menu) => (
      <a href={menu.href}>{menu.label}</a>
    ))}
  </nav>
</header>
